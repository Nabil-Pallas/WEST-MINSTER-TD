<?xml version="1.0" encoding="UTF-8"?>
<!--<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">-->
<suite name="WestministerSuite">

    <listeners>
        <listener class-name="com.listener.TestListener"></listener>
    </listeners>

    <test thread-count="1" name="WestminsterTest1">
        <groups>
            <run>
                <include name="Tier1Admin"></include>
            </run>
            <run>
                <!--                                                <include name="SANITY"></include>-->
                <include name="REGRESSION"></include>
            </run>
        </groups>
        <parameter name="Browser" value="edge"></parameter>

        <classes>
            <class name="com.westminster.testcases.login.TC_Login"/>
            <class name="com.westminster.testcases.accountSettings.TC_AccountSettings"/>
            <class name="com.westminster.testcases.admin.TC_FileManager">
                <methods>
                    <include name="validateErrorQueueWSingleEdit"/>
                    <include name="validateErrorQueueWBulkEdit"/>
                    <include name="validateDuplicateRowsInErrorQueue"/>
                    <include name="validateBulkEditAndPromote"/>

                    <include name="verifyDataMappingRefreshAfterInvalidEntryDeletion"/>
                    <include name="showPlusSymbolForSchemaManagers"/>
                    <include name="verifyDateConversionInBulkEditErrorQueue"/>
                    <include name="verifyMissingRequiredValueFilter"/>
                    <include name="verifyInvalidDateValueFormatFilter"/>
                </methods>
            </class>
            <class name="com.westminster.testcases.admin.TC_DataManager"/>
            <methods>
                <include name="verifyRestoreAllColumns"/>
                <include name="addNonExistingBrokerNameAndValidate"/>
            </methods>
            <class name="com.westminster.testcases.budgeting.TC_Budgeting">
                <methods>
                    <include name="checkDuplicateBudgetFileUpload"/>
                    <include name="validateBudgetCreationWithInvalidDateRange"/>
                </methods>
            </class>
            <class name="com.westminster.testcases.report.TC_Reports">
                <methods>
                    <include name="verifyReportDateCreatedColumn"/>
                </methods>
            </class>
        </classes>

    </test>
</suite>