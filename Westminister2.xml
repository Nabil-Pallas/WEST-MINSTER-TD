<?xml version="1.0" encoding="UTF-8"?>
<!--<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">-->
<suite name="WestministerSuite">

    <listeners>
        <listener class-name="com.listener.TestListener"></listener>
    </listeners>

    <test thread-count="1" name="WestminsterTest2">
        <groups>
            <run>
                <include name="Tier1User"></include>

            </run>
            <run>
                <!--                <include name="SANITY"></include>-->
                <include name="REGRESSION"></include>
            </run>
        </groups>
        <parameter name="Browser" value="chrome"></parameter>

        <classes>
            <class name="com.westminster.testcases.admin.TC_FileManager">
                <methods>
                    <include name="fileUploadAddSystemColumn"/>
                    <include name="mapColumns"/>
                    <include name="upload6000DataFile"/>
                    <include name="upload500KDataFile"/>
                    <include name="validateFileWithWrongDateFormat"/>
                    <include name="verifyInvalidColumnsWExistMapping"/>
                    <include name="uploadSameContentFileWDiffName"/>
                    <include name="uploadDiffContentFileWSameName"/>
                </methods>
            </class>
            <class name="com.westminster.testcases.admin.TC_UsersAndSecurity">
                <methods>
                    <include name="impersonateUser"/>
                    <include name="roleCreationAndAssignRoleToUser"/>
                </methods>
            </class>
            <class name="com.westminster.testcases.admin.TC_DataManager">
                <methods>
                    <include name="checkApplyAndCancelBtnForEditAndBulkedit"/>
                    <include name="addMoreThan10Rows"/>
                    <include name="verifyAddButtonDisabledOnTradeDateError"/>
                    <include name="verifyAddButtonDisabledOnBrokerNameError"/>
                    <include name="verifyDropdownsForAdHocRows"/>
                    <include name="verifyNoBlankSpacesOnEditTradeDetailsPage"/>
                    <include name="verifyValidRowsInDataManager"/>
                </methods>
            </class>
            <class name="com.westminster.testcases.admin.TC_RulesManager">
                <methods>
                    <include name="verifyDuplicateRuleNameError"/>
                </methods>
            </class>
        </classes>
    </test>
