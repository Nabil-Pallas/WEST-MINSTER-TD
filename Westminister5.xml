<?xml version="1.0" encoding="UTF-8"?>
<!--<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">-->
<suite name="WestministerSuite">

    <listeners>
        <listener class-name="com.listener.TestListener"></listener>
    </listeners>

    <test thread-count="1" name="WestminsterTest5">
        <groups>
            <run>
                <include name="Tier3EndUser"></include>
            </run>
            <run>
                <!--                <include name="SANITY"></include>-->
                <include name="REGRESSION"></include>
            </run>
        </groups>
        <parameter name="Browser" value="edge"></parameter>

        <classes>
            <class name="com.westminster.testcases.budgeting.TC_Budgeting">
                <methods>
                    <include name="verifyNonPositiveTargetAmountIsRejectedForBudgetItem"/>
                    <include name="verifyBudgetImportWithEditedNameAndTargetColumn"/>
                </methods>
            </class>
            <class name="com.westminster.testcases.analytics.TC_Analytics">
                <methods>
                    <include name="verifyEditAnalysis"/>
                    <include name="verifyNumericValuesInAnalysisStep1"/>
                    <include name="validateComparisonRangeOptions"/>
                    <include name="verifyPivotTableToggleOptionForFullData"/>
                </methods>
            </class>
            <class name="com.westminster.testcases.report.TC_Reports">
                <methods>
                    <include name="verifyDownloadFile"/>
                </methods>
            </class>
        </classes>
    </test>
